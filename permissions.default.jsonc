{
  // Conservative defaults for allowlist mode. `auto_safe` additionally recognizes
  // known reversible development commands and routes uncertain operations to the reviewer.
  "terminalAllowlist": [
    "git status",
    "git diff",
    "git diff --check",
    "git log",
    "git show",
    "npm run check",
    "npm test",
    "npm run test",
    "npm run typecheck",
    "npm run build",
    "composer test",
    "composer validate"
  ],
  "terminalDenylist": [
    "git push",
    "git reset --hard",
    "git clean -f",
    "git rebase",
    "git merge",
    "npm publish"
  ]
}
