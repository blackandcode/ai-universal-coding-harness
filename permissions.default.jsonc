{
  // Conservative defaults for allowlist mode. `auto_safe` additionally recognizes
  // known reversible development commands and routes uncertain operations to the reviewer.
  "terminalAllowlist": [
    // ============================================================
    // WINDOWS - READ / INSPECTION
    // ============================================================
    "ver",
    "whoami",
    "systeminfo",
    "tasklist",
    "where.exe",
    "tree",
    "netstat",
    "arp",
    "route",
    "ipconfig",
    "nslookup",
    "ping",
    "tracert",
    "reg query",
    "schtasks",
    "sc query",
    "wmic",
    // ============================================================
    // POWERSHELL - READ-ONLY / INSPECTION
    // ============================================================
    "Get-Location",
    "Get-ChildItem",
    "Get-Content",
    "Get-Item",
    "Get-ItemProperty",
    "Get-ItemPropertyValue",
    "Get-Help",
    "Get-Command",
    "Get-Process",
    "Get-Service",
    "Get-ComputerInfo",
    "Get-CimInstance",
    "Get-Volume",
    "Get-Disk",
    "Get-Partition",
    "Get-NetAdapter",
    "Get-NetIPAddress",
    "Get-NetIPConfiguration",
    "Get-NetTCPConnection",
    "Get-NetUDPEndpoint",
    "Get-FileHash",
    "Test-Path",
    "Resolve-Path",
    "Select-String",
    "Select-Object",
    "Measure-Object",
    "Compare-Object",
    "Sort-Object",
    "Format-List",
    "Format-Table",
    "ConvertTo-Json",
    "ConvertFrom-Json",
    // ============================================================
    // MICROSOFT COREUTILS FOR WINDOWS
    //
    // Explicit .exe names so PowerShell aliases don't resolve to
    // PowerShell cmdlets. Each entry matches any arguments.
    // ============================================================
    "arch.exe",
    "basename.exe",
    "dirname.exe",
    "la.exe",
    "ls.exe",
    "pwd.exe",
    "readlink.exe",
    "realpath.exe",
    "pathchk.exe",
    "cat.exe",
    "df.exe",
    "du.exe",
    "stat.exe",
    "grep.exe",
    "find.exe",
    "comm.exe",
    "cut.exe",
    "fmt.exe",
    "fold.exe",
    "head.exe",
    "join.exe",
    "nl.exe",
    "od.exe",
    "pr.exe",
    "ptx.exe",
    "sort.exe",
    "tac.exe",
    "tail.exe",
    "tr.exe",
    "unexpand.exe",
    "uniq.exe",
    "wc.exe",
    "b2sum.exe",
    "base32.exe",
    "base64.exe",
    "basenc.exe",
    "cksum.exe",
    "md5sum.exe",
    "sha1sum.exe",
    "sha224sum.exe",
    "sha256sum.exe",
    "sha384sum.exe",
    "sha512sum.exe",
    "sum.exe",
    "expr.exe",
    "factor.exe",
    "numfmt.exe",
    "seq.exe",
    "tsort.exe",
    "echo.exe",
    "printf.exe",
    "env.exe",
    "printenv.exe",
    "test.exe",
    "true.exe",
    "false.exe",
    "hostname.exe",
    "uptime.exe",
    "sleep.exe",
    "date.exe",
    "coreutils",
    "coreutils-manager",
    // ============================================================
    // RIPGREP / JSON
    // ============================================================
    "rg",
    "rg.exe",
    "jq",
    "jq.exe",
    // ============================================================
    // LINUX / WSL - READ / INSPECTION
    // ============================================================
    "ls",
    "pwd",
    "cat",
    "head",
    "tail",
    "less",
    "grep",
    "find",
    "basename",
    "dirname",
    "readlink",
    "realpath",
    "stat",
    "file",
    "wc",
    "du",
    "df",
    "cut",
    "fold",
    "fmt",
    "nl",
    "od",
    "sort",
    "uniq",
    "comm",
    "join",
    "tr",
    "md5sum",
    "sha1sum",
    "sha224sum",
    "sha256sum",
    "sha384sum",
    "sha512sum",
    "cksum",
    "uname",
    "uptime",
    "free",
    "hostname",
    "lscpu",
    "lsblk",
    "lspci",
    "lsusb",
    "ps",
    "top",
    "htop",
    "ss",
    "netstat",
    "ip",
    "hostnamectl",
    "systemctl",
    "journalctl",
    // ============================================================
    // GIT - READ-ONLY / INSPECTION
    //
    // Subcommand prefixes only — bare "git" would allow push/reset.
    // Each prefix still matches any trailing arguments.
    // ============================================================
    "git status",
    "git diff",
    "git log",
    "git show",
    "git blame",
    "git grep",
    "git ls-files",
    "git ls-tree",
    "git rev-parse",
    "git describe",
    "git shortlog",
    "git config --get",
    "git config --get-all",
    "git config --list",
    "git remote -v",
    "git branch",
    "git stash list",
    "git fetch",
    // ============================================================
    // GITHUB CLI
    // ============================================================
    "gh",
    // ============================================================
    // NODE / JAVASCRIPT
    // ============================================================
    "node",
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "tsc",
    "eslint",
    "prettier",
    "stylelint",
    "jest",
    "vitest",
    "vite",
    "webpack",
    "rollup",
    "esbuild",
    // ============================================================
    // PHP / COMPOSER / WORDPRESS
    // ============================================================
    "php",
    "php.exe",
    "composer",
    "phpunit",
    "phpstan",
    "psalm",
    "phpcs",
    "php-cs-fixer",
    "vendor/bin/phpunit",
    "vendor/bin/phpstan",
    "vendor/bin/phpcs",
    "vendor/bin/psalm",
    "vendor/bin/php-cs-fixer",
    "wp",
    // ============================================================
    // PYTHON
    // ============================================================
    "python",
    "python3",
    "pip",
    "pip3",
    "pytest",
    "ruff",
    "mypy",
    "flake8",
    // ============================================================
    // .NET / JAVA / GO / RUST / C / C++
    // ============================================================
    "dotnet",
    "java",
    "javac",
    "mvn",
    "gradle",
    "gradlew",
    "go",
    "rustc",
    "cargo",
    "gcc",
    "g++",
    "clang",
    "clang++",
    "cmake",
    "ninja",
    "make",
    "nmake",
    // ============================================================
    // DOCKER
    // ============================================================
    "docker",
    // ============================================================
    // DATABASE CLIENTS
    // ============================================================
    "mysql",
    "mysqldump",
    "psql",
    "pg_dump",
    "sqlite3",
    "redis-cli",
    // ============================================================
    // PACKAGE MANAGER INSPECTION
    // ============================================================
    "winget",
    "choco",
    "apt",
    "apt-cache",
    "dpkg",
    "dpkg-query",
    "dnf",
    "yum",
    // ============================================================
    // NETWORK / HTTP
    // ============================================================
    "curl",
    "wget",
    // ============================================================
    // ARCHIVES
    // ============================================================
    "tar",
    "unzip",
    "zip"
  ],
  "terminalDenylist": [
    "git push",
    "git reset --hard",
    "git clean -f",
    "git rebase",
    "git merge",
    "npm publish"
  ]
}
