{
  "name": "ai-universal-coding-harness",
  "version": "2.1.6",
  "description": "A cross-platform CLI that orchestrates autonomous coding harnesses through structured stages, review, quality gates, and clean Git history.",
  "keywords": [
    "agents",
    "ai",
    "automation",
    "cli",
    "codex",
    "coding-agent",
    "cursor",
    "harness",
    "orchestrator",
    "typescript"
  ],
  "homepage": "https://github.com/blackandcode/ai-universal-coding-harness#readme",
  "bugs": {
    "url": "https://github.com/blackandcode/ai-universal-coding-harness/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackandcode/ai-universal-coding-harness.git"
  },
  "bin": {
    "ai-harness": "dist/bin.js",
    "ai-universal-coding-harness": "dist/bin.js"
  },
  "files": [
    "dist/",
    "schemas/",
    "permissions.default.jsonc",
    "config.example.jsonc",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true}); require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:tests": "tsc -p tsconfig.test.json",
    "compile": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && node scripts/verify-oxlint-rules.mjs",
    "test:unit": "npm run build && npm run build:tests && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && npm run build:tests && node scripts/run-tests.mjs --coverage",
    "test:cli": "node scripts/cli-smoke.mjs",
    "test:versioning": "node --test tests/scripts/versioning.test.mjs tests/scripts/changelog.test.mjs tests/scripts/adr.test.mjs",
    "test": "npm run test:unit",
    "check:changed": "node scripts/check-changed.mjs",
    "check:touched": "node scripts/check-changed.mjs",
    "docs:check": "node scripts/docs/list-undocumented-exports.mjs",
    "pre-push": "node scripts/pre-push.mjs",
    "changelog:add": "node scripts/changelog/record-unreleased-change.mjs",
    "update-version": "node scripts/versioning/increase-version.mjs",
    "update-version:patch": "node scripts/versioning/increase-version.mjs patch",
    "update-version:minor": "node scripts/versioning/increase-version.mjs minor",
    "update-version:major": "node scripts/versioning/increase-version.mjs major",
    "adr:new": "node scripts/adr/new-adr.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:cli && node scripts/package-check.mjs",
    "check": "npm run verify",
    "setup": "npm run build && node scripts/setup-git-hooks.mjs",
    "prepack": "npm run verify"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "ink": "7.1.1",
    "jsonc-parser": "3.3.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
