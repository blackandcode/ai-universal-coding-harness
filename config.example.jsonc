// AI Universal Coding Harness configuration example.
// Preferred project-local config is created by `ai-harness init` at .ai-orchestrator/config.jsonc.
// A tracked project override may be placed at .ai-universal-coding-harness.jsonc.
// Global config location is shown by `ai-harness config paths`.
// See docs/configuration.md for full reference.
{
  "executorHarness": "cursor",
  "reviewerHarness": "codex",
  "permissionMode": "auto_safe",
  // "permissionsFile": ".ai-orchestrator/permissions.jsonc",
  "qualityCommand": "npm run check",
  "branchPrefix": "ai-harness",
  "maxPlanReviews": 4,
  "finalPlanReview": true,
  "maxExecutionAttempts": 3,
  "maxUniqueQuestionsPerStage": 100,
  "maxDiffChars": 1600000,
  "maxContextFileChars": 80000,
  "uiEventCoalesceMs": 80,
  "uiDashboardMaxRows": 26,
  "runLogMaxBytes": 20971520,
  "focusLogMaxBytes": 10485760,
  "harnessModules": [],
  "reviewer": {
    "primary": {
      "harness": "codex",
      "model": "gpt-6-astra",
      "reasoningEffort": "medium",
      "verbosity": "low",
      "timeoutMinutes": 8,
      "contextMode": "evidence_only"
    },
    "fallback": {
      "enabled": true,
      "harness": "cursor",
      "model": "gemini-3.8-flash",
      "thinking": "high",
      "timeoutMinutes": 8,
      "triggers": [
        "usage_limit",
        "rate_limit",
        "quota_exhausted",
        "no_result",
        "process_crash",
        "timeout",
        "turn_failed"
      ]
    },
    "largeDiff": {
      "thresholdChars": 300000,
      "harness": "cursor",
      "model": "gemini-3.8-flash",
      "thinking": "high",
      "timeoutMinutes": 10
    },
    "permission": {
      "harness": "cursor",
      "model": "gemini-3.8-flash",
      "thinking": "high",
      "timeoutSeconds": 30
    }
  },
  "harnesses": {
    "cursor": {
      "binary": "agent",
      "model": "gemini-3.8-flash",
      "thinking": "high",
      "turnTimeoutMinutes": 60
    },
    "codex": {
      "binary": "codex",
      "model": "gpt-6-astra",
      "reasoningEffort": "medium",
      "verbosity": "high",
      "timeoutMinutes": 8,
      "contextMode": "evidence_only"
    }
  }
}
